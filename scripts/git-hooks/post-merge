#!/usr/bin/env bash
# Auto-reseed xpath_selectors when sql/dx_siel_xpath_selectors.sql changes.
#
# Setup (1회 per RDP):
#   1) PG_DSN system env var (password 포함 URI):
#        setx PG_DSN "postgresql://USER:PASS@HOST:5432/DB"
#      (cmd 새로 열어야 반영. 새 cmd 에서 echo %PG_DSN% 로 확인)
#   2) repo 에서 1회: git config --local core.hooksPath scripts/git-hooks
#   3) psql.exe 가 Windows PATH 에 있어야 (보통 "C:\Program Files\PostgreSQL\17\bin")

CHANGED=$(git diff --name-only HEAD@{1} HEAD 2>/dev/null || true)

if echo "$CHANGED" | grep -q '^sql/dx_siel_xpath_selectors\.sql$'; then
    echo ""
    echo "[post-merge] xpath_selectors.sql changed — auto-reseed..."
    if [ -z "${PG_DSN:-}" ]; then
        echo "[post-merge] WARN: PG_DSN env var 비어있음. system env 에 PostgreSQL URI setup 필요."
        echo "[post-merge]   setx PG_DSN \"postgresql://USER:PASS@HOST:5432/DB\""
        echo "[post-merge] 수동 reseed: PGCLIENTENCODING=UTF8 psql \"\$PG_DSN\" -f sql/dx_siel_xpath_selectors.sql"
    else
        if PGCLIENTENCODING=UTF8 psql "$PG_DSN" -f sql/dx_siel_xpath_selectors.sql; then
            echo "[post-merge] reseed 완료."
        else
            echo "[post-merge] reseed 실패 — 위 psql 에러 확인. 수동 재시도 필요."
        fi
    fi
    echo ""
fi

exit 0
